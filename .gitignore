*_imx_model/

pnnx*
calibration_*.npy


# ============================================================
# 大型图片和视频
# 数据集目录已经整体排除，以下用于防止根目录误放文件
# ============================================================

*.mp4
*.avi
*.mov
*.mkv
*.webm
*.flv

