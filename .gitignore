.env
.env.*
!.env.example

*.key
*.pem
*.p12
*.pfx
credentials.json
secrets.json


# ============================================================
# 当前项目中的无用文件
# ============================================================

/=1.6.5
# ============================================================
# 例外：上传 runs/detect/val 和 runs/detect/stage2_screening
# 必须放在文件末尾，才能覆盖前面的 *.jpg / *.png / weights/ 等规则
# ============================================================
!/runs/detect/val/**
!/runs/detect/stage2_screening/**
!/runs/detect/stage3_targeted/**
!/runs/detect/stage3_fast_screen/**
!/runs/detect/stage4_smallobj/**

# 两个目录共同排除：权重、事件文件、大体积的预测结果
/runs/detect/*/**/*.pt
/runs/detect/*/**/*.pth
/runs/detect/*/**/*.onnx
/runs/detect/*/**/*.engine
/runs/detect/*/**/events.out.tfevents.*
/runs/detect/*/**/predictions.json
