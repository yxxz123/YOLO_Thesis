# ============================================================
# YOLO_Thesis .gitignore
# 保留：Python源码、模型YAML、训练配置、论文相关代码
# 排除：数据集、训练结果、模型权重、虚拟环境、缓存、IDE文件
# ============================================================


# Python 缓存与编译文件
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.dll


# Python 构建和安装产物
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
wheels/
pip-wheel-metadata/
*.egg-info/
ultralytics.egg-info/
.installed.cfg
*.egg
MANIFEST


# Python 虚拟环境
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version
__pypackages__/


# IDE 与编辑器配置
.idea/
.vscode/
*.iml
*.code-workspace
.project
.pydevproject
.settings/


# Jupyter 与 IPython
.ipynb_checkpoints/
profile_default/
ipython_config.py


# 测试、覆盖率与静态检查缓存
.pytest_cache/
.mypy_cache/
.dmypy.json
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
.hypothesis/
.pyre/
.cache/
.ruff_cache/


# ============================================================
# 数据集
# ============================================================

/datasets/
datasets/

# 常见数据集缓存和标注中间产物
*.cache
*.npy
*.npz
*.pkl
*.pickle


# ============================================================
# 训练、验证及推理结果
# ============================================================
/runs/*
!/runs/detect/
/runs/detect/*
!/runs/detect/val/
!/runs/detect/stage2_screening/
!/runs/detect/stage3_targeted/
!/runs/detect/stage3_fast_screen/
!/runs/detect/stage4_smallobj/

/tide_result/
tide_result/

/wandb/
wandb/

/swanlog/
swanlog/

/mlruns/
mlruns/

/tensorboard/
tensorboard/

# 训练过程自动生成文件
events.out.tfevents.*


